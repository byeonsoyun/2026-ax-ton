# Google Cloud Text-to-Speech
GOOGLE_TTS_API_KEY=

# 로컬 TTS 엔진 (영상 렌더링 + 라이브 화면 듣기 버튼 공용, tools/README.md 참고, 계정/키 불필요)
PIPER_BIN_PATH=tools/piper/piper/piper.exe
